<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MainMaster.master.cs" Inherits="PtclCustomerService.MainMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <title>PCS - PTCL Customer Service</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="Css/bootstrap.min.css" rel="stylesheet" />
    <link href="Css/pcs.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/js/all.min.js" crossorigin="anonymous"></script>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <header class="site-head">
            <div class="site-wrap site-head-inner">
                <a class="pcs-brand site-brand" href="<%= ResolveUrl("~/Home.aspx") %>">
                    <span class="pcs-mark"><i class="fas fa-phone-alt"></i></span>
                    <span class="pcs-brand-text"><strong>PCS</strong><span>PTCL Customer Service</span></span>
                </a>
                <nav class="site-nav" aria-label="Main">
                    <a href="#plans">Packages</a>
                    <asp:HyperLink ID="HypLogin" runat="server" Text="Log in" NavigateUrl="~/UserLogin.aspx" Visible="false"></asp:HyperLink>
                    <asp:HyperLink ID="HypUserPanel" runat="server" Text="My dashboard" CssClass="btn btn-primary btn-sm" NavigateUrl="~/Dashboard/User/UserDashboard.aspx" Visible="false"></asp:HyperLink>
                    <asp:HyperLink ID="HypAdminPanel" runat="server" Text="Admin dashboard" CssClass="btn btn-primary btn-sm" NavigateUrl="~/Dashboard/Admin/AdminDashboard.aspx" Visible="false"></asp:HyperLink>
                    <asp:HyperLink ID="HypLogout" runat="server" Text="Log out" NavigateUrl="~/Logout.aspx" Visible="false"></asp:HyperLink>
                </nav>
            </div>
        </header>

        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>

        <footer class="site-foot">
            <div class="site-wrap">
                PCS, a university project by Muhammad Shehryar (2021). Not connected to PTCL.
            </div>
        </footer>
    </form>
</body>
</html>
