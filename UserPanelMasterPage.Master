<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="UserPanelMasterPage.master.cs" Inherits="PtclCustomerService.UserPanelMasterPage" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <title>PCS - Customer</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="PCS - PTCL Customer Service" />
    <meta name="author" content="Muhammad Shehryar" />
    <link href="Css/bootstrap.min.css" rel="stylesheet" />
    <link href="Css/pcs.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/js/all.min.js" crossorigin="anonymous"></script>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="pcs-shell">
            <aside class="pcs-sidebar" id="pcsSidebar">
                <asp:HyperLink runat="server" CssClass="pcs-brand" NavigateUrl="~/Dashboard/User/UserDashboard.aspx">
                    <span class="pcs-mark"><i class="fas fa-phone-alt"></i></span>
                    <span class="pcs-brand-text"><strong>PCS</strong><span>PTCL Customer Service</span></span>
                </asp:HyperLink>

                <nav class="pcs-nav" aria-label="Customer menu">
                    <asp:HyperLink ID="HypDashBoard" runat="server" CssClass="nav-link" NavigateUrl="~/Dashboard/User/UserDashboard.aspx">
                        <i class="fas fa-home"></i> Dashboard
                    </asp:HyperLink>
                    <asp:HyperLink ID="HypComplaint" runat="server" CssClass="nav-link" NavigateUrl="~/Complaints/User/UserComplaint.aspx?Active=1">
                        <i class="fas fa-clipboard-list"></i> My complaints
                    </asp:HyperLink>
                    <asp:HyperLink ID="HypUserBill" runat="server" CssClass="nav-link" NavigateUrl="~/Billing/User/UserBill.aspx">
                        <i class="fas fa-file-invoice"></i> Bills
                    </asp:HyperLink>

                    <div class="pcs-nav-heading">Account</div>
                    <asp:HyperLink ID="HypProfile" runat="server" CssClass="nav-link" NavigateUrl="~/ManageAccounts/User/UserProfile.aspx">
                        <i class="fas fa-user"></i> My profile
                    </asp:HyperLink>
                </nav>

                <div class="pcs-sidebar-foot">
                    <asp:Label ID="lblName" runat="server" CssClass="pcs-who"></asp:Label>
                    <asp:HyperLink ID="HypLogout" Text="Log out" runat="server" NavigateUrl="~/Logout.aspx?userSide=1"></asp:HyperLink>
                </div>
            </aside>
            <div class="pcs-scrim" data-pcs-close></div>

            <div class="pcs-main">
                <header class="pcs-topbar">
                    <button type="button" class="pcs-menu-btn" data-pcs-menu aria-controls="pcsSidebar" aria-label="Open menu"><i class="fas fa-bars"></i></button>
                    <span class="pcs-brand"><span class="pcs-mark"><i class="fas fa-phone-alt"></i></span><span class="pcs-brand-text"><strong>PCS</strong></span></span>
                </header>

                <main class="pcs-content">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </main>

                <footer class="pcs-footer">
                    PCS, a university project by Muhammad Shehryar (2021). Not connected to PTCL.
                </footer>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.1/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
        <script src="<%= ResolveUrl("~/Js/pcs.js") %>"></script>
    </form>
</body>
</html>
